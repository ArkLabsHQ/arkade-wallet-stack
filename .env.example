# ==============================================================================
# Arkade Wallet Stack — configuration
# ==============================================================================
# Copy this file to `.env` and fill it in, OR just run `./setup.sh`, which
# prompts for the REQUIRED values and generates the SECRETS for you.
#
# docker compose reads `.env` from this directory automatically.
# Your real `.env` is git-ignored — never commit it.
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. REQUIRED — you must set these
# ------------------------------------------------------------------------------

# Base domain for the stack. Every service is exposed on a subdomain of it:
#
#   delegate.<BASE_DOMAIN>   ->  fulmine delegate API (VTXO refresh)
#   lnurl.<BASE_DOMAIN>      ->  LNURL / Lightning Address server
#   backup.<BASE_DOMAIN>     ->  encrypted contract-backup server
#   covclaim.<BASE_DOMAIN>   ->  covenant-claim daemon (public pubkey / REST)
#
# You MUST create a DNS A record for each of those four names, pointing at this
# server's public IP, before TLS certificates can be issued.
BASE_DOMAIN=example.com

# Email Caddy registers with Let's Encrypt for your TLS certificates.
ACME_EMAIL=admin@example.com

# --- The Arkade Service (arkd) you connect to ---------------------------------
# You get these endpoints from your Arkade Service operator (e.g. Ark Labs).
# This stack does NOT run its own Arkade Service — it connects to a hosted one.

# fulmine reaches the Arkade Service as a URL (scheme + host[:port]).
ARKADE_SERVER_URL=https://arkd.example.com

# covclaimd reaches the SAME Arkade Service, but over gRPC (host:port form).
# Usually the same server as ARKADE_SERVER_URL, expressed as a gRPC endpoint.
COVCLAIM_ARK_URL=arkd.example.com:7070

# covclaimd also needs the covenant emulator (the signer), over gRPC (host:port).
COVCLAIM_EMULATOR_URL=emulator.example.com:7073

# Esplora-compatible chain API base URL, used by fulmine for on-chain lookups.
# A public mainnet Esplora works, e.g. https://mempool.space/api
ESPLORA_URL=https://mempool.space/api


# ------------------------------------------------------------------------------
# 2. SECRETS — leave BLANK; `./setup.sh` generates strong random values.
#    (If setting by hand: each *_KEY must be 32 bytes as 64 hex characters.)
# ------------------------------------------------------------------------------

# Encrypts wallet tokens at rest in lnurl-server. 32-byte hex (64 chars).
LNURL_TOKEN_ENCRYPTION_KEY=

# secp256k1 private key for covclaimd. 32-byte hex (64 chars).
COVCLAIM_SECRET_KEY=

# Password for the bundled Postgres (used only by contract-backup).
POSTGRES_PASSWORD=

# NOTE: the fulmine wallet password is NOT stored here. setup.sh writes it to
#       ./secrets/fulmine_password (chmod 600); fulmine reads that to auto-unlock.


# ------------------------------------------------------------------------------
# 3. TUNABLES — sensible defaults; change only if you need to.
# ------------------------------------------------------------------------------

# Fee (satoshis) the fulmine delegate charges per delegation. 0 = free.
FULMINE_DELEGATE_FEE=0


# --- Advanced: override pinned container image versions -----------------------
# Uncomment to pin/upgrade. Defaults live in docker-compose.yml.
# FULMINE_IMAGE=ghcr.io/arklabshq/fulmine:v0.3.25
# LNURL_IMAGE=ghcr.io/arklabshq/lnurl-server:0.2.6
# COVCLAIMD_IMAGE=ghcr.io/arkade-os/covclaimd:v0.0.1-rc.0
# BUCKET_SYNC_IMAGE=ghcr.io/kukks/bucket-sync-server:latest
# CADDY_IMAGE=caddy:2
# POSTGRES_IMAGE=postgres:16
